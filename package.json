{
  "name": "tradinggoats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:agents": "bun src/engine/agents/test-runner/run.ts",
    "test:hyperliquid": "bun src/adapters/hyperliquid/tests.ts",
    "test:hyperliquid:discovery": "bun src/adapters/hyperliquid/discoverySmoke.ts",
    "test:execution": "bun src/engine/execution/tests.ts",
    "test:hyperliquid:execution": "bun src/adapters/hyperliquid/executionTests.ts",
    "test:hyperliquid:discovery:policy": "bun src/adapters/hyperliquid/discoveryTests.ts",
    "test:wallet": "bun src/services/wallet/testRunner.ts",
    "test:theme": "bun src/services/theme/testRunner.ts",
    "test:conditions": "bun src/engine/conditions/conditionParity.ts",
    "test:engine": "server/.venv/bin/python -m pytest server",
    "server:setup": "python3 -m venv server/.venv && server/.venv/bin/python -m pip install --upgrade pip && server/.venv/bin/python -m pip install -e 'server[dev]'",
    "server:start": "server/.venv/bin/python -m tradingv_engine",
    "verify": "bun run lint && bun run test:audit && bun run test:hardening && bun run test:trade-engine && bun run test:trade-flow && bun run test:clear-session && bun run test:runtime-lifecycle && bun run test:surface && bun run test:conditions && bun run test:engine && bun run test:pipeline && bun run test:security && bun run test:agents && bun run test:venue && bun run test:hyperliquid && bun run test:hyperliquid:execution && bun run test:execution && bun run test:openrouter && bun run test:wallet && bun run verify:no-bots && bun run verify:no-triggers && cd watchers && npm run typecheck && npm test",
    "test:pipeline": "bun src/engine/agents/pipelineAcceptance.ts",
    "test:audit": "bun src/engine/agents/trackers/auditRegressionTests.ts",
    "test:hardening": "bun src/engine/goat/releaseHardeningTests.ts",
    "test:surface": "bun src/engine/goat/agentSurfaceTests.ts",
    "test:backtest": "bun src/engine/goat/backtest/tests.ts",
    "test:backtest-lifecycle": "bun src/engine/goat/backtest/managerTests.ts",
    "watcher:dev": "cd watchers && npx wrangler dev --local",
    "watcher:test": "cd watchers && npm test",
    "watcher:test:runtime": "cd watchers && npm run test:runtime",
    "watcher:deploy": "cd watchers && npx wrangler deploy",
    "watcher:typecheck": "cd watchers && npm run typecheck",
    "test:security": "bun src/engine/core/testRunner.ts",
    "verify:no-bots": "bash scripts/verify-no-bots.sh",
    "verify:no-triggers": "bash scripts/verify-no-triggers.sh",
    "test:venue": "bun src/config/venueTests.ts",
    "test:openrouter": "bun src/adapters/openrouter/tests.ts",
    "test:openrouter:live": "bun src/adapters/openrouter/liveCheck.ts",
    "test:goat:live": "bun src/engine/goat/liveEndToEnd.ts",
    "test:firebase": "bun src/services/firebase/tests.ts",
    "test:rules": "bun src/services/firebase/rulesTests.ts",
    "test:historical": "bun src/engine/backtester/historicalUnitTests.ts",
    "test:trade-engine": "bun src/engine/goat/tradeEngineTests.ts",
    "test:trade-flow": "bun src/engine/goat/backtestTradeFlowTests.ts",
    "test:runtime-lifecycle": "bun src/engine/goat/durableRuntimeTests.ts",
    "test:clear-session": "bun src/engine/goat/clearSessionTests.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@privy-io/react-auth": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.19.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
