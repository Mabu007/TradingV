# Copy to `.env` and fill in the values you need. `.env` is git-ignored;
# only this template is committed. Never commit a real credential.
#
# Vite exposes every variable prefixed with `VITE_` to the browser bundle.
# Anything secret (private keys, seed phrases, signing secrets, server API
# keys) MUST NOT use that prefix. See docs/environment.md.

# ============================================================
# PUBLIC FRONTEND VARIABLES (browser-visible, safe to ship)
# ============================================================

# Privy application id. Required for wallet sign-in and authentication.
# Obtained from the Privy dashboard (https://dashboard.privy.io).
# Without it the app runs with a permanently disconnected wallet.
VITE_PRIVY_APP_ID=""

# Optional Privy app client id, when your dashboard issues one.
VITE_PRIVY_CLIENT_ID=""

# Optional. Comma-separated Privy login methods to show, e.g. "email,wallet".
# Leave empty to use whatever is enabled in the Privy dashboard.
VITE_PRIVY_LOGIN_METHODS=""

# Optional Privy API URL override. Development and testing only.
VITE_PRIVY_API_URL=""

# Hyperliquid venue environment used for discovery, quotes and candles,
# and recorded on every GOAT deployment.
#
# "MAINNET" or "TESTNET". Case and surrounding whitespace are ignored; any
# other value resolves to MAINNET, because a typo must not silently point a
# deployment at the network you did not choose.
#
# Changing this switches the venue for the whole application. A deployment
# made against one environment will not act in the other.
#
# Mainnet is the default because it is the real market data. It does not
# enable real trading: this build has no order-signing service, GOATs deploy
# as SHADOW or DEMO, and SHADOW executes nothing.
VITE_HYPERLIQUID_NETWORK="MAINNET"

# Public URL where the app is hosted. Used for self-referential links.
VITE_APP_URL="http://localhost:3000"

# Optional build-time OpenRouter key for the AI assistant. This is PUBLIC.
# Prefer letting each user enter their own key in Settings instead.
VITE_OPENROUTER_API_KEY=""

# Base URL of the Python condition engine. The engine reads market data
# and decides WHEN the AI should be woken; it never trades. If it is not
# running, tracker conditions show as unavailable rather than guessing.
VITE_TRADINGV_ENGINE_URL="http://127.0.0.1:8099"

# ============================================================
# CONDITION ENGINE (server process, never VITE_-prefixed)
# ============================================================
#
# The engine runs as a separate local process:
#
#   bun run server:setup     # once, creates server/.venv
#   bun run server:start     # then, in a second terminal
#
# It reads Hyperliquid's PUBLIC endpoints only. There is no credential for
# it to hold, and adding one would be a design mistake, not a feature:
# a component that can place orders has no business deciding when to wake
# the AI.

# Bind address and port for the engine's HTTP surface. Keep it on
# localhost: the engine is a local service, not a public API.
TRADINGV_ENGINE_HOST="127.0.0.1"
# The engine's mutating endpoints are unauthenticated, so a non-loopback
# bind is refused unless this is set. Leave it unset.
TRADINGV_ENGINE_ALLOW_PUBLIC=""
TRADINGV_ENGINE_PORT="8099"

# Venue network. "MAINNET" or "TESTNET", matching VITE_HYPERLIQUID_NETWORK
# above: the engine and the frontend must agree on which network they are
# reading. Any unrecognised value resolves to MAINNET, so a typo cannot
# silently point the engine somewhere you did not choose.
TRADINGV_NETWORK="MAINNET"

# Optional endpoint override for a self-hosted proxy of the venue.
#
# Honoured only when it agrees with TRADINGV_NETWORK. A mismatch is refused
# rather than preferred, because preferring one would leave the process
# reporting one network while reading another, and the discrepancy would
# only show up as a market that never loads.
TRADINGV_HYPERLIQUID_API=""

# Seconds between market polls. A tracker's own
# `minEvaluationIntervalMs` can slow it down further but never speeds it up.
TRADINGV_POLL_INTERVAL="20"

# HTTP timeout for venue requests, in seconds. A slow venue should read as
# UNKNOWN, not as a condition that is not met.
TRADINGV_HTTP_TIMEOUT="10"

# Candles retained per (market, timeframe). Sized so a 200-period EMA plus
# a 500-bar breakout has room to warm up.
TRADINGV_HISTORY="1500"

# Not used by the current frontend build. They are documented here so the
# future signing boundary has a defined home. They belong in a backend
# service or a secret manager, never in this repository.

# Privy server API secret for privileged Privy API calls.
# PRIVY_SECRET_KEY=""

# Privy access-token verification key, for validating a user JWT server-side.
# PRIVY_VERIFICATION_KEY=""

# Privy JWT auth secret, for minting and verifying tokens server-side.
# PRIVY_AUTH_SECRET=""

# Server-side Hyperliquid agent wallet address.
# HYPERLIQUID_API_WALLET=""

# Server-side Hyperliquid agent private key. Never reaches the browser
# and never reaches an AI agent.
# HYPERLIQUID_PRIVATE_KEY=""

# Encryption secret for the stored Hyperliquid agent wallet.
# HYPERLIQUID_WALLET_SECRET=""

# Server-side OpenRouter key for trusted backend calls.
# OPENROUTER_API_KEY=""

# ============================================================
# VENUE AND EXECUTION NOTES
# ============================================================
#
# Market data comes from Hyperliquid's public REST and WebSocket endpoints
# and needs no credentials.
#
# Setting TRADINGV_LIVE_TRADING has no effect and is not a supported
# configuration. The engine has no execution code path to enable. It is
# called out here so nobody spends an afternoon looking for the switch.
#
# LIVE execution is not implemented. Demo fills, demo P&L, and demo margin
# are produced by the Hyperliquid DEMO adapter. Connecting a Privy wallet
# gives the user an identity; it does not enable live trading, and no code
# path can sign or send a real order.

# ---------------------------------------------------------------------------
# Accounts, data, and the durable runtime
# ---------------------------------------------------------------------------
#
# Both of these are optional, and leaving them unset is a supported state rather
# than a broken one. What each one buys, and what happens without it, is worth
# reading before either is filled in.
#
# FIREBASE — accounts and product data
#
#   Without these, the application runs exactly as it did before them: no
#   account, data on this device, and a stated reason in place of the sign-in
#   form. Nothing silently pretends to be signed in.
#
#   With them, registration and sign-in are handled by Firebase, and a session
#   survives a refresh. Data is then written under users/{uid}/… and the
#   Firestore rules in firestore.rules decide what may be read or written —
#   which is why those rules are enforced by an emulator test rather than by
#   reading them.
#
#   Create a project, enable Email/Password under Authentication, then copy the
#   values from Project settings. These are *not* secrets: a Firebase web
#   config is public by design, and the rules are what protect the data. Do not
#   put a service-account key here — nothing in this application uses one, and
#   shipping one to a browser would hand over the whole project.
#
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
#
# THE WATCHER SERVICE — what survives closing the tab
#
#   The Durable Object tier holds the durable runtime identity of a deployed
#   tracker: its last evaluation, its cooldowns, its pending wake and its
#   heartbeat. Without this URL a GOAT runs only while this tab is open, and the
#   application says so rather than implying otherwise.
#
#   The browser authenticates with a Firebase ID token — the same project as
#   above — and the worker verifies it. There is deliberately no shared secret in
#   the browser: a secret in a bundle is a secret everybody has.
#
#   Set REQUIRE_FIREBASE_AUTH=true on the worker (see watchers/wrangler.toml) so
#   a missing project id fails loudly instead of falling back to a single
#   development user.
#
# VITE_WATCHERS_URL=https://watchers.example.workers.dev
