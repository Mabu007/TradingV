# Copy to .env and fill in what you need. All values are optional.

# URL where the app is hosted. Used for self-referential links and API endpoints.
APP_URL="http://localhost:3000"

# Hyperliquid network used for discovery, quotes, and candles.
# mainnet (default) or testnet
VITE_HYPERLIQUID_NETWORK="mainnet"

# Optional. OpenRouter key for the AI assistant. Users can also enter their
# own key in the in-app Settings screen.
OPENROUTER_API_KEY=""

# TradingVibe requires no venue credentials: market data comes from
# Hyperliquid's public endpoints, and no live execution path exists yet.
